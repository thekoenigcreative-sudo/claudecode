# Copy to .env (gitignored). Never commit .env.

# Required only for broker: live in config.yaml. Set by hand, by me, when I mean it.
LIVE_TRADING_CONFIRMED=no

# IBKR (Phase 2+). IB Gateway host/port/client id.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=7

# Optional contact for the collector's user agent (asx.com.au). Leave blank to omit.
COLLECTOR_CONTACT=

# Telegram bot for the ARENA trader agents (BotFather /newbot). Real value in .env only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
